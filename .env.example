# ── Nginx Proxy Manager (reverse proxy, owns 80/443) ────────────────────
NPM_UI_PORT=81                     # admin UI
NPM_EMAIL=admin@example.com        # initial admin account
NPM_PASS=change-me-npm-admin

# ── GitLab ────────────────────────────────────────────────────────────────
GITLAB_EXTERNAL_URL=http://localhost:8081
GITLAB_ROOT_PASSWORD=change-me-root
# From: GitLab Admin Area → Settings → CI/CD → Runners (Existing runners)
GITLAB_RUNNER_REGISTER_TOKEN=change-me-runner-token
GITLAB_SSH_PORT=2222
GITLAB_DIRECT_PORT=8081            # direct access port (bypasses nginx-manager)

# ── Vaultwarden ───────────────────────────────────────────────────────────
VAULTWARDEN_DOMAIN=http://localhost:8090
VAULTWARDEN_SIGNUPS_ALLOWED=true
VAULTWARDEN_ADMIN_TOKEN=change-me-admin-token

# ── ETCD ──────────────────────────────────────────────────────────────────
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
ETCD_BACKUP_INTERVAL=3600     # seconds between snapshots
ETCD_KEEP_BACKUPS=24          # number of snapshots to retain

# ── Grafana ───────────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ── Jenkins ───────────────────────────────────────────────────────────────
JENKINS_PORT=9080

# ── Portainer ─────────────────────────────────────────────────────────────
PORTAINER_UI_PORT=9443
PORTAINER_AGENT_PORT=9000

# ── Rancher ───────────────────────────────────────────────────────────────
RANCHER_HTTPS_PORT=9444
RANCHER_BOOTSTRAP_PASSWORD=change-me-rancher
RANCHER_CLUSTER_ID=local

# ── Misc ──────────────────────────────────────────────────────────────────
TZ=UTC
